package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

func pcStr(p *model.Participant) string {
	if p.PCNumber == nil {
		return "-"
	}
	return fmt.Sprintf("%02d", *p.PCNumber)
}

func ipStr(p *model.Participant) string {
	if p.IPAddress == nil {
		return "-"
	}
	return *p.IPAddress
}

func pwStr(p *model.Participant) string {
	if p.PlainPassword == nil || *p.PlainPassword == "" {
		return "-"
	}
	return *p.PlainPassword
}

func queueCount(participants []*model.Participant) int {
	n := 0
	for _, p := range participants {
		if p.PCNumber == nil {
			n++
		}
	}
	return n
}

templ ParticipantsPage(participants []*model.Participant, saved bool, errMsg string) {
	@AppLayout("Participants", "participants") {
		@PageHeader("Participants", "Register participants then shuffle PC numbers.") {
			<a href="/jury/participants/export" class="btn-tonal">
				<span class="material-symbols-outlined text-lg" aria-hidden="true">download</span>
				Export
			</a>
			<a href="/jury/participants/shuffle" class="btn-primary">
				<span class="material-symbols-outlined text-lg" aria-hidden="true">shuffle</span>
				Shuffle
			</a>
		}
		if saved {
			@Flash("success", "Saved.")
		}
		if errMsg != "" {
			@Flash("error", errMsg)
		}
		<div class="grid grid-cols-12 gap-4">
			<div class="col-span-12 lg:col-span-4 space-y-4">
				@Card("Registration") {
					<form method="POST" action="/jury/participants" class="space-y-4">
						<div class="field">
							<label for="p-name">Participant Name</label>
							<input id="p-name" class="input" name="name" required placeholder="Full name"/>
						</div>
						<div class="field">
							<label for="p-school">Member</label>
							<input id="p-school" class="input" name="school" required placeholder="School name"/>
						</div>
						<div class="field">
							<label for="p-pc">PC Number (optional)</label>
							<input id="p-pc" class="input" type="number" name="pc_number" min="1" max="99" placeholder="e.g. 12"/>
						</div>
						<button type="submit" class="btn-primary w-full justify-center">
							<span class="material-symbols-outlined text-lg" aria-hidden="true">person_add</span>
							Add Participant
						</button>
					</form>
				}
				@Card("Import Participants") {
					<p class="text-body-small text-on-surface-variant mb-4">
						Upload an Excel file to replace participant and module data. Headers: no_pc, ip_address, member, name, [module columns...]
					</p>
					<form action="/jury/participants/import" method="POST" enctype="multipart/form-data" class="space-y-4" onsubmit="return confirm('All participant and module data will be replaced. Continue?')">
						<label class="group flex items-center justify-between gap-3 px-4 py-3 rounded-xl border-2 border-dashed border-outline-variant bg-surface-container-low hover:border-primary hover:bg-primary/5 transition cursor-pointer focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary">
							<span class="flex items-center gap-3 min-w-0">
								<span class="material-symbols-outlined text-primary" aria-hidden="true">description</span>
								<span class="min-w-0">
									<span class="block text-body-medium text-on-surface">Choose file</span>
									<span id="file-name" class="block truncate text-label-small text-on-surface-variant">No file selected</span>
								</span>
							</span>
							<span class="text-label-small font-bold text-primary uppercase">Browse</span>
							<input type="file" name="file" accept=".xlsx,.xls" required class="sr-only"
								onchange="document.getElementById('file-name').innerText = this.files[0]?.name || 'No file selected'"/>
						</label>
						@Flash("warning", "Import overwrites all participant and module data. Make sure the file is correct.")
						<button type="submit" class="btn-primary w-full justify-center">
							<span class="material-symbols-outlined text-lg" aria-hidden="true">sync</span>
							Upload &amp; Sync
						</button>
					</form>
				}
			</div>
			<div class="col-span-12 lg:col-span-8 space-y-4">
				@Card(fmt.Sprintf("Queue (%d without a seat)", queueCount(participants))) {
					if queueCount(participants) == 0 {
						@EmptyState("group", "Queue empty", "Participants without a PC number show up here.") {
						}
					} else {
						<ul class="divide-y divide-outline-variant">
							for _, p := range participants {
								if p.PCNumber == nil {
									<li class="flex justify-between items-center py-3">
										<div class="min-w-0">
											<div class="text-on-surface truncate">{ p.Name }</div>
											<div class="text-label-small text-on-surface-variant truncate">{ p.School }</div>
										</div>
										<form method="POST" action={ templ.URL(fmt.Sprintf("/jury/participants/%d/delete", p.ID)) } onsubmit="return confirm('Delete this participant?')">
											<button type="submit" class="btn-ghost text-error px-2 py-1" aria-label={ "Delete " + p.Name }>
												<span class="material-symbols-outlined text-lg" aria-hidden="true">close</span>
											</button>
										</form>
									</li>
								}
							}
						</ul>
					}
				}
				@Card("Final Seat Assignment") {
					<div class="table-wrap">
						<table class="data-table">
							<thead>
								<tr>
									<th>Seat</th>
									<th>IP</th>
									<th>Name</th>
									<th>Member</th>
									<th>Password</th>
									<th>Action</th>
								</tr>
							</thead>
							<tbody>
								if len(participants)-queueCount(participants) == 0 {
									<tr><td colspan="6" class="text-center text-on-surface-variant py-8">Not shuffled yet.</td></tr>
								}
								for _, p := range participants {
									if p.PCNumber != nil {
										<tr>
											<td class="font-bold">{ pcStr(p) }</td>
											<td>{ ipStr(p) }</td>
											<td>{ p.Name }</td>
											<td>{ p.School }</td>
											<td class="font-mono">{ pwStr(p) }</td>
											<td>
												<form method="POST" action={ templ.URL(fmt.Sprintf("/jury/participants/%d/delete", p.ID)) } onsubmit="return confirm('Delete this participant?')">
													<button type="submit" class="btn-ghost text-error px-2 py-1" aria-label={ "Delete " + p.Name }>Delete</button>
												</form>
											</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
