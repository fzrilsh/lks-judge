package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

// Dashboard is the participant's live page: active module, public files, and the
// per-module submission form. dashboard.js drives it over the WebSocket. The
// #sensor-layer overlay covers the form until the submission window opens.
templ Dashboard(p *model.Participant, module *model.Module, publicFiles []*model.File, existing *model.Submission, formOpen bool) {
	@GuestLayout("Dashboard", "", p.Name) {
		<div class="w-full max-w-4xl mx-auto space-y-6 py-8">
			<!-- Header -->
			<div class="bg-surface-container-low rounded-3xl shadow-lg p-6 flex items-center justify-between">
				<div>
					<h1 class="text-headline-medium text-on-surface font-manrope">{ p.Name }</h1>
					<p class="text-body-medium text-on-surface-variant">
						if p.PCNumber != nil {
							PC <strong>{ fmt.Sprintf("%02d", *p.PCNumber) }</strong> |
						}
						{ p.School }
					</p>
				</div>
				<form method="POST" action="/logout">
					<button type="submit" class="bg-error text-on-error px-5 py-2 rounded-xl font-semibold hover:shadow-lg transition-shadow">
						Logout
					</button>
				</form>
			</div>
			<!-- Active module + countdown -->
			<div class="bg-surface-container-low rounded-3xl shadow-lg p-6">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-label-medium text-on-surface-variant">Modul aktif</p>
						<p class="text-title-large text-on-surface font-manrope">
							<span id="module_name">
								if module != nil {
									{ module.Name }
								} else {
									-
								}
							</span>
						</p>
						<input type="hidden" id="module_id" value={ moduleIDValue(module) }/>
					</div>
					<div class="text-right">
						<p class="text-label-medium text-on-surface-variant">Sisa waktu</p>
						<p id="countdown" class="text-title-large text-on-surface font-manrope">--:--:--</p>
					</div>
				</div>
			</div>
			<!-- Public files -->
			<div class="bg-surface-container-low rounded-3xl shadow-lg p-6">
				<h2 class="text-title-large text-on-surface font-manrope mb-4">File resmi</h2>
				<div id="official-files-list" class="grid gap-3 sm:grid-cols-2">
					if len(publicFiles) == 0 {
						<p class="empty-placeholder text-body-medium text-on-surface-variant col-span-full">Belum ada file publik.</p>
					}
					for _, f := range publicFiles {
						<a data-file-id={ f.ID } href={ templ.URL(fmt.Sprintf("/files/%s/download", f.ID)) }
							class="flex items-center justify-between gap-2 bg-surface-container rounded-2xl px-4 py-3 hover:bg-surface-container-highest transition-colors">
							<span class="file-name text-body-medium text-on-surface truncate">{ f.Name }</span>
							<span class="text-label-small text-primary">Download</span>
						</a>
					}
				</div>
			</div>
			<!-- Submission form -->
			<div class="relative bg-surface-container-low rounded-3xl shadow-lg p-6">
				<h2 class="text-title-large text-on-surface font-manrope mb-4">Kumpulkan pekerjaan</h2>
				<div id="existing-submission" class="mb-4">
					if existing != nil {
						<div class="bg-tertiary-container text-on-tertiary-container rounded-2xl p-4">
							<p class="text-body-medium">Sudah dikumpulkan: <strong>{ existing.Name }</strong></p>
							if existing.SubmittedAt != nil {
								<p class="text-label-small">{ existing.SubmittedAt.Local().Format("15:04:05") }</p>
							}
							<p class="text-label-small mt-1">Upload baru akan menggantikan file ini.</p>
						</div>
					}
				</div>
				<label id="dropzone"
					data-upload-type="submission"
					data-module-id={ moduleIDValue(module) }
					data-success-url="/"
					data-error-url="/?error="
					class="flex flex-col items-center justify-center gap-2 border-2 border-dashed border-outline rounded-2xl px-6 py-10 text-center cursor-pointer hover:bg-surface-container-highest transition-colors">
					<span class="text-body-large text-on-surface">Drag file ke sini atau klik untuk memilih</span>
					<span class="text-body-small text-on-surface-variant">Diunggah dalam potongan 2MB, bisa dilanjutkan.</span>
					<input id="file-input" type="file" class="hidden"/>
				</label>
				<div id="progress-wrap" class="hidden mt-4">
					<div class="flex justify-between text-label-small text-on-surface-variant mb-1">
						<span id="progress-name"></span>
						<span id="progress-pct">0%</span>
					</div>
					<div class="w-full h-2 bg-surface-container-highest rounded-full overflow-hidden">
						<div id="progress-bar" class="h-full bg-primary transition-all" style="width:0%"></div>
					</div>
				</div>
				<!-- Sensor overlay: hidden while the form is open -->
				<div id="sensor-layer"
					class={ "absolute inset-0 rounded-3xl bg-surface-container-highest/95 flex items-center justify-center text-center p-6", templ.KV("hidden", formOpen) }>
					<p class="text-title-medium text-on-surface-variant font-manrope">Form pengumpulan belum dibuka.</p>
				</div>
			</div>
		</div>
		<script src="/static/js/uploader.js"></script>
		<script src="/static/js/dashboard.js"></script>
	}
}

// moduleIDValue renders the hidden input value for the active module, "" when none.
func moduleIDValue(m *model.Module) string {
	if m == nil {
		return ""
	}
	return fmt.Sprintf("%d", m.ID)
}
