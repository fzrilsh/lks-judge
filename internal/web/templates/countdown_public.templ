package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

templ CountdownPublicPage(comp *model.Competition) {
	@TVLayout("Countdown") {
		<div class="w-full text-center px-4 sm:px-6">
			<img src="/static/imgs/logo.png" class="mx-auto w-32 sm:w-48 md:w-60 mb-4 sm:mb-6" alt="Logo"/>
			if comp != nil {
				<h1 class="font-manrope font-extrabold text-2xl sm:text-4xl md:text-5xl text-on-surface mb-6 sm:mb-8 break-words">{ comp.Name }</h1>
			}
			<p
				id="cd-clock"
				if comp != nil {
					data-alert={ fmt.Sprint(comp.ID) }
				}
				class="text-on-surface font-bold tabular-nums leading-none"
				style="font-size:clamp(3rem,18vw,16rem)"
			>
				--:--:--
			</p>
			<p class="text-base sm:text-title-large text-on-surface-variant uppercase tracking-widest mt-6 sm:mt-8">
				<span id="cd-status">
					if comp != nil {
						{ comp.Status }
					} else {
						waiting
					}
				</span>
			</p>
		</div>
		<div class="fixed bottom-4 inset-x-0">
			@Watermark()
		</div>
		<script src="/static/js/countdown.js" defer></script>
	}
}
