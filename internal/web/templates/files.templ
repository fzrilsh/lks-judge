package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

templ FilesPage(comp *model.Competition, files []*model.File, saved bool, errMsg string) {
	@AppLayout("Files", "files") {
		@PageHeader("Competition Files", "Asset and documentation repository.") {
		}
		if saved {
			@Flash("success", "Saved.")
		}
		if errMsg != "" {
			@Flash("error", errMsg)
		}
		@Card("") {
			<label id="dropzone" for="file-input"
				class="group flex flex-col items-center justify-center text-center cursor-pointer border-2 border-dashed border-outline-variant rounded-xl py-12 px-6 bg-surface-container-low hover:border-primary hover:bg-primary/5 transition focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary">
				<span class="w-14 h-14 mb-4 flex items-center justify-center rounded-full bg-primary/10 text-primary">
					<span class="material-symbols-outlined text-3xl group-hover:scale-110 transition" aria-hidden="true">cloud_upload</span>
				</span>
				<p class="text-body-medium text-on-surface mb-1">Click or drag a file here</p>
				<p class="text-label-small text-on-surface-variant">Upload an asset or any file</p>
				<input id="file-input" type="file" class="sr-only"/>
			</label>
			<div id="progress-wrap" class="hidden mt-4">
				<div class="flex justify-between text-label-small text-on-surface-variant mb-1">
					<span id="progress-name"></span>
					<span id="progress-pct" aria-live="polite">0%</span>
				</div>
				<div class="w-full h-2 bg-surface-container-highest rounded-full overflow-hidden">
					<div id="progress-bar" class="h-full bg-primary transition-all" style="width:0%"></div>
				</div>
			</div>
		}
		<div class="mt-6">
			@Card(fmt.Sprintf("Active Assets (%d)", len(files))) {
			if len(files) == 0 {
				@EmptyState("folder_open", "No files yet", "Uploaded files show up here.") {
				}
			} else {
				<ul class="space-y-3">
					for _, f := range files {
						<li class="bg-surface-container-low rounded-xl p-4 flex justify-between items-center gap-4">
							<div class="flex items-center gap-3 min-w-0">
								<span class="w-11 h-11 rounded-lg bg-surface-container-high flex items-center justify-center flex-none">
									<span class="material-symbols-outlined text-on-surface-variant" aria-hidden="true">description</span>
								</span>
								<p class="text-on-surface truncate">{ f.Name }</p>
							</div>
							<div class="flex items-center gap-3 flex-none">
								<form method="POST" action={ templ.URL(fmt.Sprintf("/jury/files/%s/toggle", f.ID)) }>
									if f.IsPublic {
										<button type="submit" class="chip chip-ok cursor-pointer transition active:scale-95 hover:brightness-95" aria-label={ "Hide " + f.Name }>
											<span class="material-symbols-outlined text-sm" aria-hidden="true">visibility</span>
											Public
										</button>
									} else {
										<button type="submit" class="chip chip-neutral cursor-pointer transition active:scale-95 hover:brightness-95" aria-label={ "Publish " + f.Name }>
											<span class="material-symbols-outlined text-sm" aria-hidden="true">visibility_off</span>
											Private
										</button>
									}
								</form>
								<a href={ templ.URL(fmt.Sprintf("/files/%s/download", f.ID)) } class="btn-ghost px-2 py-1" aria-label={ "Download " + f.Name }>
									<span class="material-symbols-outlined text-lg" aria-hidden="true">download</span>
								</a>
								<form method="POST" action={ templ.URL(fmt.Sprintf("/jury/files/%s/delete", f.ID)) } onsubmit="return confirm('Delete this file?')">
									<button type="submit" class="btn-ghost text-error px-2 py-1" aria-label={ "Delete " + f.Name }>
										<span class="material-symbols-outlined text-lg" aria-hidden="true">delete</span>
									</button>
								</form>
							</div>
						</li>
					}
				</ul>
			}
			}
		</div>
		<script src="/static/js/uploader.js" defer></script>
	}
}
