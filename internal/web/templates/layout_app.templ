package templates

// competitionName returns the header title. Wired once at startup in
// cmd/server/main.go to read the competition state cache. Falls back to a
// constant so tests and cold starts still render.
var competitionName = func() string { return "LKS Judge Platform" }

// SetCompetitionName wires the header-title accessor. Call once at startup.
func SetCompetitionName(fn func() string) { competitionName = fn }

templ AppLayout(title string, activePage string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - LKS Judge Platform</title>
		<link rel="icon" type="image/png" href="/static/imgs/logo.png"/>
		<link rel="stylesheet" href="/static/css/app.css"/>
		<script src="/static/js/reset.js" defer></script>
		<script src="/static/js/forms.js" defer></script>
	</head>
	<body class="bg-surface text-on-surface min-h-screen font-manrope">
		<!-- CSS-only sidebar toggle: the checkbox drives peer-checked on the drawer + backdrop. No JS. -->
		<input type="checkbox" id="nav-toggle" class="peer sr-only"/>
		<header class="fixed top-0 w-full z-50 flex justify-between items-center px-4 md:px-6 h-16 bg-surface-container-lowest/85 backdrop-blur-md border-b border-outline-variant">
			<div class="flex items-center gap-3 min-w-0">
				<label for="nav-toggle" class="lg:hidden inline-flex items-center justify-center w-10 h-10 -ml-2 rounded-xl text-on-surface-variant hover:bg-surface-container-high cursor-pointer" aria-label="Open menu">
					<span class="material-symbols-outlined" aria-hidden="true">menu</span>
				</label>
				<span class="text-lg md:text-xl font-bold truncate">{ competitionName() }</span>
			</div>
			<form method="post" action="/jury/reset" onsubmit="return confirmReset()">
				<button type="submit" class="btn-danger px-3 py-2 text-label-medium" aria-label="Reset all data">Reset</button>
			</form>
		</header>
		<!-- Backdrop: only interactive when the drawer is open (<lg). Clicking it unchecks the toggle. -->
		<label for="nav-toggle" class="fixed inset-0 top-16 z-30 bg-on-surface/30 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity lg:hidden" aria-hidden="true"></label>
		<aside class="fixed left-0 top-16 z-40 h-[calc(100vh-64px)] w-64 flex flex-col p-4 bg-surface-container-low border-r border-outline-variant -translate-x-full peer-checked:translate-x-0 lg:translate-x-0 transition-transform">
			<nav class="flex-1 space-y-1">
				@navItem("/jury/", "dashboard", "Dashboard", activePage == "dashboard")
				@navItem("/jury/competition", "settings", "Competition", activePage == "competition")
				@navItem("/jury/countdown", "alarm", "Countdown", activePage == "countdown")
				@navItem("/jury/participants", "groups", "Participants", activePage == "participants")
				@navItem("/jury/submissions", "upload_file", "Submissions", activePage == "submissions")
				@navItem("/jury/modules", "inventory_2", "Modules", activePage == "modules")
				@navItem("/jury/scoring", "edit_document", "Scoring", activePage == "scoring")
				@navItem("/jury/automark", "fact_check", "Automark", activePage == "automark")
				@navItem("/jury/files", "folder_open", "Files", activePage == "files")
			</nav>
		</aside>
		<main class="lg:ml-64 mt-16 min-h-[calc(100vh-64px)]">
			<div class="mx-auto max-w-[1400px] p-4 md:p-6 lg:p-8">
				{ children... }
			</div>
		</main>
	</body>
	</html>
}

templ navItem(href string, icon string, label string, active bool) {
	<a
		href={ templ.URL(href) }
		class="sidebar-link"
		if active {
			aria-current="page"
		}
	>
		<span class="material-symbols-outlined" aria-hidden="true">{ icon }</span>
		<span>{ label }</span>
	</a>
}
