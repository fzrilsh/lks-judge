package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

// Dashboard is the participant's live page: active module, public files, and the
// per-module submission form. dashboard.js drives it over the WebSocket. The
// #sensor-layer overlay covers the form until the submission window opens.
templ Dashboard(p *model.Participant, module *model.Module, publicFiles []*model.File, existing *model.Submission, formOpen bool, errorMsg string) {
	@GuestLayout("Dashboard") {
		<div class="max-w-6xl mx-auto p-4 md:p-6 lg:p-8">
			<div class="flex items-center justify-between gap-4 mb-6">
				<div class="min-w-0">
					<h1 class="text-headline-small text-on-surface truncate">{ p.Name }</h1>
					<p class="text-body-medium text-on-surface-variant">
						if p.PCNumber != nil {
							PC <strong>{ fmt.Sprintf("%02d", *p.PCNumber) }</strong> ·
						}
						{ p.School }
					</p>
				</div>
				<form method="POST" action="/logout">
					<button type="submit" class="btn-danger">
						<span class="material-symbols-outlined text-lg" aria-hidden="true">logout</span>
						Logout
					</button>
				</form>
			</div>
			if errorMsg != "" {
				@Flash("error", errorMsg)
			}
			<div class="card flex items-center justify-between gap-4 mb-6">
				<div>
					<p class="text-label-medium text-on-surface-variant">Active module</p>
					<p class="text-title-large text-on-surface">
						if module != nil {
							{ module.Name }
						} else {
							-
						}
					</p>
				</div>
				<div class="text-right">
					<p class="text-label-medium text-on-surface-variant">Time left</p>
					<p id="countdown" class="text-title-large font-mono tabular-nums text-on-surface" aria-live="polite">--:--:--</p>
				</div>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
				<div class="lg:col-span-7 space-y-4">
					<h2 class="text-title-large text-on-surface">Official Files</h2>
					<div id="official-files-list" class="space-y-3">
						if len(publicFiles) == 0 {
							<p class="empty-placeholder text-body-medium text-on-surface-variant">No public files yet.</p>
						}
						for _, f := range publicFiles {
							<div data-file-id={ f.ID } class="bg-surface-container-low p-5 rounded-xl flex justify-between items-center">
								<div class="flex items-center gap-4">
									<div class="w-12 h-12 bg-surface-container-high rounded-lg flex items-center justify-center">
										<span class="material-symbols-outlined" aria-hidden="true">description</span>
									</div>
									<div>
										<p class="file-name font-bold text-on-surface">{ f.Name }</p>
									</div>
								</div>
								<a href={ templ.URL(fmt.Sprintf("/files/%s/download", f.ID)) } class="p-2 hover:bg-primary/10 text-primary rounded-lg" aria-label={ "Download " + f.Name }>
									<span class="material-symbols-outlined" aria-hidden="true">download</span>
								</a>
							</div>
						}
					</div>
				</div>
				<div class="lg:col-span-5">
					<div class="sticky top-24 space-y-6">
						<div class="card relative">
							<div id="sensor-layer"
								class={ "absolute inset-0 bg-surface-container-lowest/70 backdrop-blur-sm z-10 flex flex-col items-center justify-center text-center p-6 rounded-2xl", templ.KV("hidden", formOpen) }>
								<div class="w-16 h-16 bg-surface-container rounded-full flex items-center justify-center mb-4">
									<span class="material-symbols-outlined text-3xl text-on-surface-variant" aria-hidden="true">lock</span>
								</div>
								<h3 class="text-title-medium text-on-surface mb-1">Submission Locked</h3>
								<p class="text-body-medium text-on-surface-variant">Opens in the last 20 minutes.</p>
							</div>
							<div class="text-center mb-4">
								<span class="material-symbols-outlined text-4xl text-primary" aria-hidden="true">cloud_upload</span>
								<h3 class="text-title-large text-on-surface mt-1">Upload Submission</h3>
							</div>
							<div id="client-flash"></div>
							<div id="existing-submission" class="mb-4">
								if existing != nil {
									<div class="bg-secondary-container text-on-secondary-container rounded-xl p-4">
										<p class="text-body-medium">Submitted: <strong>{ existing.Name }</strong></p>
										if existing.SubmittedAt != nil {
											<p class="text-label-small">{ existing.SubmittedAt.Local().Format("15:04:05") }</p>
										}
										<p class="text-label-small mt-1">A new upload will replace this file.</p>
									</div>
								}
							</div>
							<span class="text-body-medium text-on-surface mb-2 hidden">
								<span id="module_name">
									if module != nil {
										{ module.Name }
									} else {
										-
									}
								</span>
							</span>
							<input type="text" id="module_id" name="module_id" value={ moduleIDValue(module) } hidden/>
							<label id="dropzone" for="file-input"
								data-upload-type="submission"
								data-module-id={ moduleIDValue(module) }
								data-success-url="/"
								data-error-url="/?error="
								class="flex flex-col items-center justify-center gap-2 border-2 border-dashed border-outline rounded-2xl px-6 py-10 text-center cursor-pointer hover:bg-surface-container-highest transition focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary">
								<span class="text-body-large text-on-surface">Drag a file here or click to select</span>
								<input id="file-input" type="file" class="sr-only"/>
							</label>
							<div id="progress-wrap" class="hidden mt-4">
								<div class="flex justify-between text-label-small text-on-surface-variant mb-1">
									<span id="progress-name"></span>
									<span id="progress-pct" aria-live="polite">0%</span>
								</div>
								<div class="w-full h-2 bg-surface-container-highest rounded-full overflow-hidden">
									<div id="progress-bar" class="h-full bg-primary transition-all" style="width:0%"></div>
								</div>
							</div>
						</div>
						@Card("Submission Guidelines") {
							<ul class="text-body-medium space-y-2 text-on-surface-variant list-disc pl-5">
								<li>Make sure the file name matches the requested format.</li>
								<li>Maximum file size is 2 GB.</li>
								<li>Late submissions will be rejected.</li>
							</ul>
						}
					</div>
				</div>
			</div>
		</div>
		<script src="/static/js/uploader.js" defer></script>
		<script src="/static/js/dashboard.js" defer></script>
	}
}

// moduleIDValue renders the hidden input value for the active module, "" when none.
func moduleIDValue(m *model.Module) string {
	if m == nil {
		return ""
	}
	return fmt.Sprintf("%d", m.ID)
}
