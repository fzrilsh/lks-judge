package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

func isCurrentModule(c *model.Competition, m *model.Module) bool {
	return c.CurrentModuleID != nil && *c.CurrentModuleID == m.ID
}

templ ModulesPage(comp *model.Competition, modules []*model.Module, saved bool, errMsg string) {
	@AppLayout("Modules", "modules") {
		@PageHeader("Modul", "Atur modul lomba untuk scoring.") {
			if len(modules) > 0 {
				<form method="POST" action="/jury/modules/set-current" class="flex items-end gap-2" onsubmit="return confirm('Jadikan modul ini yang aktif?')">
					<div class="field">
						<label for="cur-mod">Modul aktif</label>
						<select id="cur-mod" name="module_id" class="input">
							for _, m := range modules {
								<option value={ fmt.Sprint(m.ID) } selected?={ isCurrentModule(comp, m) }>{ m.Name }</option>
							}
						</select>
					</div>
					<button type="submit" class="btn-primary">Set</button>
				</form>
			}
		}
		if saved {
			@Flash("success", "Tersimpan.")
		}
		if errMsg != "" {
			@Flash("error", errMsg)
		}
		@Card("Generate Modul") {
			<p class="text-body-small text-on-surface-variant mb-4">Membuat MA, MB, MC, ... setelah modul yang sudah ada.</p>
			<form method="POST" action="/jury/modules/generate" class="flex gap-3 items-end" onsubmit="return confirm('Generate modul baru?')">
				<div class="field">
					<label for="gen-total">Jumlah</label>
					<select id="gen-total" name="total" class="input">
						for _, n := range []int{1, 2, 3, 4, 5, 6, 7} {
							<option value={ fmt.Sprint(n) }>{ fmt.Sprint(n) }</option>
						}
					</select>
				</div>
				<button type="submit" class="btn-tonal">Generate</button>
			</form>
		}
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			for i, m := range modules {
				<section class="card relative overflow-hidden">
					<div class="absolute left-0 top-0 w-1.5 h-full bg-primary" aria-hidden="true"></div>
					<div class="flex justify-between items-start mb-4">
						<span class="h-11 w-11 bg-primary-container text-on-primary-container rounded-lg flex items-center justify-center font-bold">{ "M" + fmt.Sprint(i+1) }</span>
						<form method="POST" action={ templ.URL(fmt.Sprintf("/jury/modules/%d/delete", m.ID)) } onsubmit="return confirm('Hapus modul ini?')">
							<button type="submit" class="btn-ghost text-error px-2 py-1" aria-label={ "Hapus " + m.Name }>
								<span class="material-symbols-outlined text-lg" aria-hidden="true">close</span>
							</button>
						</form>
					</div>
					<form method="POST" action={ templ.URL(fmt.Sprintf("/jury/modules/%d/rename", m.ID)) } class="space-y-3">
						<div class="field">
							<label for={ fmt.Sprintf("mod-name-%d", m.ID) }>Nama Modul</label>
							<input id={ fmt.Sprintf("mod-name-%d", m.ID) } type="text" name="name" value={ m.Name } class="input"/>
						</div>
						<button type="submit" class="btn-primary w-full justify-center">Update</button>
					</form>
				</section>
			}
			<form method="POST" action="/jury/modules"
				class="card border-2 border-dashed border-outline-variant flex flex-col items-center justify-center gap-3 text-center hover:bg-surface-container-low">
				<label class="sr-only" for="new-mod">Nama modul baru</label>
				<input id="new-mod" type="text" name="name" placeholder="Modul baru" required class="input text-center"/>
				<button type="submit" class="btn-ghost text-primary">
					<span class="material-symbols-outlined text-lg" aria-hidden="true">add</span>
					Tambah Modul
				</button>
			</form>
		</div>
	}
}
