package templates

func navLeftOr(s string) string {
	if s == "" {
		return "Lomba Kompetensi Siswa"
	}
	return s
}

templ GuestLayout(title string, navLeft string, navRight string) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - LKS Judge Platform</title>
		<link rel="icon" type="image/png" href="/static/imgs/logo.png"/>
		<link rel="stylesheet" href="/static/css/app.css"/>
	</head>
	<body class="bg-surface text-on-surface min-h-screen font-manrope">
		<nav class="fixed top-0 w-full z-50 flex justify-between items-center px-4 md:px-6 h-16 bg-surface-container-lowest/80 backdrop-blur-md border-b border-outline-variant">
			<span class="text-lg md:text-xl font-bold text-on-surface">{ navLeftOr(navLeft) }</span>
			<span class="text-on-surface-variant">{ navRight }</span>
		</nav>
		<main class="pt-20 min-h-screen">
			{ children... }
		</main>
	</body>
	</html>
}

// TVLayout is a chromeless full-screen shell for projector pages (the public
// countdown): no navbar, content vertically centered.
templ TVLayout(title string) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - LKS Judge Platform</title>
		<link rel="icon" type="image/png" href="/static/imgs/logo.png"/>
		<link rel="stylesheet" href="/static/css/app.css"/>
	</head>
	<body class="bg-surface text-on-surface min-h-screen flex items-center justify-center font-manrope">
		{ children... }
	</body>
	</html>
}
