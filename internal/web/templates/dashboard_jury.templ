package templates

import (
	"fmt"
	"strconv"
	"time"

	"github.com/fzrilsh/lks-judge/internal/web/dashboardview"
)

// dashSeconds formats a remaining-seconds count as H:MM:SS or MM:SS.
func dashSeconds(s int) string {
	if s <= 0 {
		return "00:00"
	}
	h, m, sec := s/3600, (s%3600)/60, s%60
	if h > 0 {
		return fmt.Sprintf("%d:%02d:%02d", h, m, sec)
	}
	return fmt.Sprintf("%02d:%02d", m, sec)
}

// dashRelative renders a coarse "x menit lalu" relative time.
func dashRelative(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "baru saja"
	case d < time.Hour:
		return strconv.Itoa(int(d.Minutes())) + " menit lalu"
	case d < 24*time.Hour:
		return strconv.Itoa(int(d.Hours())) + " jam lalu"
	default:
		return t.Format("2 Jan 15:04")
	}
}

func statusChipKind(status string) string {
	switch status {
	case "running":
		return "ok"
	case "paused":
		return "warn"
	case "finished":
		return "danger"
	default:
		return "neutral"
	}
}

func awardChipKind(award string) string {
	switch award {
	case "Gold":
		return "warn"
	case "Silver", "Bronze":
		return "neutral"
	case "Medallion for Excellence":
		return "ok"
	default:
		return "neutral"
	}
}

func orDash(s string) string {
	if s == "" {
		return "-"
	}
	return s
}

func maxInt(a, b int) int {
	if a > b {
		return a
	}
	return b
}

templ DashboardJuryPage(d *dashboardview.Data) {
	@AppLayout("Dashboard", "dashboard") {
		@PageHeader("Dashboard", d.Comp.Name) {
			@Chip(statusChipKind(d.Comp.Status), d.Comp.Status)
		}
		<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
			@dashStatusCard(d)
			@dashCountdownCard(d)
			@dashProgressCard(d)
			@dashTopCard(d)
			@dashActivityCard(d)
			@dashChartsCard()
		</div>
		<script type="application/json" id="dash-chart-data">
			@templ.Raw(d.ChartJSON)
		</script>
		<script src="/static/js/vendor/chart.umd.min.js" defer></script>
		<script src="/static/js/dashboard_jury.js" defer></script>
	}
}

templ dashStatusCard(d *dashboardview.Data) {
	@Card("Status Kompetisi") {
		<dl class="space-y-3 text-body-medium">
			<div class="flex justify-between gap-4">
				<dt class="text-on-surface-variant">Level</dt>
				<dd class="text-on-surface text-right">{ orDash(d.Comp.Level) }</dd>
			</div>
			<div class="flex justify-between gap-4">
				<dt class="text-on-surface-variant">Tanggal</dt>
				<dd class="text-on-surface text-right">{ orDash(d.Comp.StartDate) } &ndash; { orDash(d.Comp.EndDate) }</dd>
			</div>
			<div class="flex justify-between gap-4">
				<dt class="text-on-surface-variant">Modul aktif</dt>
				<dd class="text-on-surface text-right">
					if d.CurrentModule != nil {
						{ d.CurrentModule.Name }
					} else {
						<span class="text-on-surface-variant">belum dipilih</span>
					}
				</dd>
			</div>
			<div class="flex justify-between gap-4">
				<dt class="text-on-surface-variant">Total modul</dt>
				<dd class="text-on-surface text-right">{ strconv.Itoa(d.Modules) }</dd>
			</div>
		</dl>
	}
}

templ dashCountdownCard(d *dashboardview.Data) {
	@Card("Countdown") {
		<p class="text-headline-large font-mono tabular-nums text-on-surface" aria-live="polite">{ dashSeconds(d.Seconds) }</p>
		<div class="mt-2 flex items-center gap-2">
			@Chip(statusChipKind(d.Comp.Status), d.Comp.Status)
			if d.FormOpen {
				@Chip("ok", "Form terbuka")
			} else {
				@Chip("neutral", "Form tertutup")
			}
		</div>
		<div class="mt-4 flex flex-wrap gap-2">
			<form method="post" action="/jury/countdown/pause">
				<button type="submit" class="btn-ghost px-3 py-2 text-label-medium">Pause</button>
			</form>
			<form method="post" action="/jury/countdown/resume">
				<button type="submit" class="btn-ghost px-3 py-2 text-label-medium">Resume</button>
			</form>
			<form method="post" action="/jury/countdown/stop" onsubmit="return confirm('Hentikan countdown?')">
				<button type="submit" class="btn-danger px-3 py-2 text-label-medium">Stop</button>
			</form>
		</div>
	}
}

templ dashProgressCard(d *dashboardview.Data) {
	@Card("Progress") {
		<div class="grid grid-cols-2 gap-4">
			<div>
				<p class="text-headline-medium text-on-surface">{ strconv.Itoa(d.Participants) }</p>
				<p class="text-label-medium text-on-surface-variant">Peserta ({ strconv.Itoa(d.Seated) } ber-seat)</p>
			</div>
			<div>
				<p class="text-headline-medium text-on-surface">{ strconv.Itoa(d.NotSubmitted) }</p>
				<p class="text-label-medium text-on-surface-variant">Belum submit apa pun</p>
			</div>
		</div>
		<div class="mt-4">
			<div class="flex justify-between text-label-medium text-on-surface-variant mb-1">
				<span>Submission</span>
				<span>{ strconv.Itoa(d.Submissions) } / { strconv.Itoa(d.SubmissionSlots) }</span>
			</div>
			<progress class="w-full h-2 [&::-webkit-progress-bar]:bg-surface-container-high [&::-webkit-progress-value]:bg-primary [&::-moz-progress-bar]:bg-primary rounded-full" value={ strconv.Itoa(d.Submissions) } max={ strconv.Itoa(maxInt(d.SubmissionSlots, 1)) }></progress>
		</div>
	}
}

templ dashTopCard(d *dashboardview.Data) {
	@Card("Top 3 Leaderboard") {
		if len(d.Top) == 0 {
			@EmptyState("leaderboard", "Belum ada skor", "Nilai peserta muncul di sini setelah scoring.") {
			}
		} else {
			<ol class="space-y-3">
				for _, e := range d.Top {
					<li class="flex items-center gap-3">
						<span class="flex-none w-7 h-7 rounded-full bg-surface-container-high text-on-surface-variant grid place-items-center text-label-medium font-semibold">{ strconv.Itoa(e.Rank) }</span>
						<span class="flex-1 min-w-0">
							<span class="block truncate text-on-surface">{ e.Name }</span>
							<span class="block truncate text-label-small text-on-surface-variant">{ e.School }</span>
						</span>
						<span class="text-title-medium font-semibold text-on-surface tabular-nums">{ strconv.Itoa(e.WSI) }</span>
						if e.Award != "" {
							@Chip(awardChipKind(e.Award), e.Award)
						}
					</li>
				}
			</ol>
		}
	}
}

templ dashActivityCard(d *dashboardview.Data) {
	@Card("Aktivitas Terbaru") {
		if len(d.Activity) == 0 {
			@EmptyState("history", "Belum ada aktivitas", "Pengumpulan submission dan peserta aktif tampil di sini.") {
			}
		} else {
			<ul class="space-y-3 max-h-80 overflow-y-auto">
				for _, a := range d.Activity {
					<li class="flex items-start gap-3 text-body-medium">
						<span class="material-symbols-outlined text-lg text-on-surface-variant" aria-hidden="true">{ a.Icon }</span>
						<span class="flex-1 min-w-0">
							<span class="block text-on-surface">{ a.Text }</span>
							<span class="block text-label-small text-on-surface-variant">{ dashRelative(a.When) }</span>
						</span>
					</li>
				}
			</ul>
		}
	}
}

templ dashChartsCard() {
	<section class="card md:col-span-2 xl:col-span-3">
		<h2 class="text-title-medium text-on-surface mb-4">Statistik Submission</h2>
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			<div>
				<p class="text-label-medium text-on-surface-variant mb-2">Waktu pengumpulan (menit setelah mulai)</p>
				<canvas id="chart-timing" height="200"></canvas>
			</div>
			<div>
				<p class="text-label-medium text-on-surface-variant mb-2">Submission per modul</p>
				<canvas id="chart-module" height="200"></canvas>
			</div>
		</div>
	</section>
}
