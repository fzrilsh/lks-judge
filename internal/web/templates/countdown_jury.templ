package templates

import "github.com/fzrilsh/lks-judge/internal/model"

func timeValue(t *string) string {
	if t == nil {
		return ""
	}
	if len(*t) > 5 {
		return (*t)[:5] // <input type="time"> wants HH:MM
	}
	return *t
}

templ CountdownJuryPage(comp *model.Competition, saved bool, errMsg string) {
	@AppLayout("Countdown", "countdown") {
		<div class="max-w-7xl mx-auto px-8 flex flex-col min-h-[calc(100vh-64px)]">
			<div class="flex justify-between items-end mb-12">
				<div>
					<h1 class="text-4xl font-bold mt-1">
						Live Competition Countdown
					</h1>
				</div>
				<a href="/countdown" target="_blank" class="text-sm text-on-surface-variant underline">
					Public display
				</a>
			</div>
			if saved {
				<div class="bg-secondary-container text-on-secondary-container rounded-xl p-4 mb-8">
					<p>Saved. Countdown re-armed.</p>
				</div>
			}
			if errMsg != "" {
				<div class="bg-error-container text-on-error-container rounded-xl p-4 mb-8">
					<p>{ errMsg }</p>
				</div>
			}
			<section class="flex-grow flex items-center justify-center bg-surface-container-lowest rounded-xl ambient-shadow p-12 mb-12 relative overflow-hidden">
				<div class="absolute inset-0 opacity-5 pointer-events-none">
					<div class="absolute -top-24 -right-24 w-96 h-96 bg-primary rounded-full blur-3xl"></div>
					<div class="absolute -bottom-24 -left-24 w-96 h-96 bg-secondary rounded-full blur-3xl"></div>
				</div>
				<div class="text-center relative z-10">
					<p id="cd-clock" class="text-[10rem] leading-none font-bold tabular-nums">--:--:--</p>
					<p class="mt-4 text-sm uppercase tracking-wider text-on-surface-variant">
						Status: <span id="cd-status" class="font-semibold">{ comp.Status }</span>
					</p>
				</div>
			</section>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<form id="cd-config" method="POST" action="/jury/countdown" class="contents">
					<div class="bg-surface-container-low p-8 rounded-xl flex flex-col gap-4">
						<h3 class="font-bold text-lg">Start Time Configuration</h3>
						<div>
							<label class="block text-xs text-on-surface-variant mb-2">
								START TIME
							</label>
							<input type="time" name="start_time" required value={ timeValue(comp.StartTime) }
								class="w-full bg-surface-container-high rounded-xl p-4 text-xl font-bold focus:ring-1 focus:ring-primary"/>
						</div>
					</div>
					<div class="bg-surface-container-low p-8 rounded-xl flex flex-col gap-4">
						<h3 class="font-bold text-lg">End Time Configuration</h3>
						<div>
							<label class="block text-xs text-on-surface-variant mb-2">
								END TIME
							</label>
							<input type="time" name="end_time" required value={ timeValue(comp.EndTime) }
								class="w-full bg-surface-container-high rounded-xl p-4 text-xl font-bold focus:ring-1 focus:ring-primary"/>
						</div>
					</div>
				</form>
				<div class="bg-surface-container-highest p-8 rounded-xl flex flex-col justify-between">
					<div>
						<h3 class="font-bold text-lg">Countdown Control</h3>
						<p class="text-sm text-on-surface-variant">
							Affects watchers
						</p>
					</div>
					<div class="flex gap-4 mt-6">
						<!-- All four controls live in the DOM; countdown.js shows the pair
						     that matches the polled status so the buttons stay in sync with
						     the clock without a page reload. data-cd-show lists the statuses
						     each control is visible for. -->
						<form method="POST" action="/jury/countdown/resume" class="flex-1" data-cd-show="paused">
							<button type="submit" class="w-full text-center signature-gradient text-white py-4 rounded-xl font-bold active:scale-95 transition">
								RESUME
							</button>
						</form>
						<button type="submit" form="cd-config" class="flex-1 text-center signature-gradient text-white py-4 rounded-xl font-bold active:scale-95 transition" data-cd-show="waiting running">
							SAVE
						</button>
						<form method="POST" action="/jury/countdown/pause" class="flex-1" data-cd-show="running">
							<button type="submit" class="w-full text-center bg-amber-500 text-white py-4 rounded-xl font-bold active:scale-95 transition">
								PAUSE
							</button>
						</form>
						<form method="POST" action="/jury/countdown/stop" data-cd-show="waiting paused">
							<button type="submit" onclick="return confirm('Stop the countdown?')"
								class="px-6 py-4 text-center bg-red-500 text-white rounded-xl font-bold">
								STOP
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
		<script src="/static/js/countdown.js" defer></script>
	}
}
