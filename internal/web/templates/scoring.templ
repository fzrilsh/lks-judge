package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

// Scoring renders the jury raw-score matrix: rows participants, columns modules,
// each cell a decimal number input. score[participantID][moduleID] is the saved
// raw score (nil = blank). Posts the whole grid to /jury/scoring.
templ Scoring(comp *model.Competition, participants []*model.Participant, modules []*model.Module, score map[int64]map[int64]*float64, saved bool, errMsg string) {
	@AppLayout("Scoring", "scoring") {
		@PageHeader("Scoring", "Input nilai mentah tiap peserta per modul.") {
			<a href="/leaderboard" target="_blank" class="btn-tonal">
				<span class="material-symbols-outlined text-lg" aria-hidden="true">leaderboard</span>
				Leaderboard
			</a>
			<a href="/jury/scoring/export-pdf" class="btn-primary">
				<span class="material-symbols-outlined text-lg" aria-hidden="true">picture_as_pdf</span>
				Export PDF
			</a>
		}
		if saved {
			@Flash("success", "Tersimpan.")
		}
		if errMsg != "" {
			@Flash("error", errMsg)
		}
		if len(participants) == 0 {
			@Card("") {
				@EmptyState("groups", "Belum ada peserta", "Daftarkan peserta dulu sebelum scoring.") {
					<a href="/jury/participants" class="btn-primary">Ke Peserta</a>
				}
			}
		} else {
			@Card("") {
				<form method="post" action="/jury/scoring">
					<div class="table-wrap">
						<table class="data-table">
							<thead>
								<tr>
									<th>Seat</th>
									<th>Peserta</th>
									for _, m := range modules {
										<th class="text-center">{ m.Name }</th>
									}
									<th class="text-right">Total</th>
								</tr>
							</thead>
							<tbody>
								for _, p := range participants {
									<tr>
										<td class="font-bold">
											if p.PCNumber != nil {
												{ fmt.Sprintf("%02d", *p.PCNumber) }
											} else {
												-
											}
										</td>
										<td>
											<p class="text-on-surface">{ p.Name }</p>
											<p class="text-label-small text-on-surface-variant">{ p.School }</p>
										</td>
										for _, m := range modules {
											<td class="text-center">
												<label class="sr-only" for={ fmt.Sprintf("score_%d_%d", p.ID, m.ID) }>{ p.Name + " - " + m.Name }</label>
												<input
													id={ fmt.Sprintf("score_%d_%d", p.ID, m.ID) }
													type="number" step="0.01" min="0" max="100"
													name={ fmt.Sprintf("score_%d_%d", p.ID, m.ID) }
													value={ scoreValue(score, p.ID, m.ID) }
													data-participant={ fmt.Sprintf("%d", p.ID) }
													class="score-input input w-16 text-center px-2"
												/>
											</td>
										}
										<td class="text-right">
											<span id={ fmt.Sprintf("total-%d", p.ID) } class="text-title-medium font-bold text-primary tabular-nums">0</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					<div class="flex justify-end mt-4">
						<button type="submit" class="btn-primary">
							<span class="material-symbols-outlined text-lg" aria-hidden="true">save</span>
							Simpan Nilai
						</button>
					</div>
				</form>
			}
		}
		<script>
			document.addEventListener('DOMContentLoaded', function() {
				const inputs = document.querySelectorAll('.score-input');
				function recompute(participantId) {
					const group = document.querySelectorAll(`.score-input[data-participant="${participantId}"]`);
					let total = 0;
					group.forEach(inp => { total += parseFloat(inp.value) || 0; });
					const el = document.getElementById(`total-${participantId}`);
					if (el) el.innerText = total.toFixed(2);
				}
				const seen = new Set();
				inputs.forEach(input => {
					const id = input.getAttribute('data-participant');
					input.addEventListener('input', function() { recompute(id); });
					if (!seen.has(id)) { seen.add(id); recompute(id); }
				});
			});
		</script>
	}
}

// scoreValue renders the saved raw score for a cell, or "" when unset.
func scoreValue(score map[int64]map[int64]*float64, pid, mid int64) string {
	if ms, ok := score[pid]; ok {
		if v, ok := ms[mid]; ok && v != nil {
			return fmt.Sprintf("%g", *v)
		}
	}
	return ""
}
