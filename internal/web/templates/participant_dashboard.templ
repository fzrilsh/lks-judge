package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

// Dashboard is the participant's live page: active module, public files, and the
// per-module submission form. dashboard.js drives it over the WebSocket. The
// #sensor-layer overlay covers the form until the submission window opens.
templ Dashboard(p *model.Participant, module *model.Module, publicFiles []*model.File, existing *model.Submission, formOpen bool) {
	@GuestLayout("Dashboard", "", p.Name) {
		<div class="p-12 px-6 max-w-6xl mx-auto">
			<!-- Header -->
			<div class="flex items-center justify-between mb-8">
				<div>
					<h1 class="text-2xl font-bold font-manrope text-on-surface">{ p.Name }</h1>
					<p class="text-sm text-on-surface-variant">
						if p.PCNumber != nil {
							PC <strong>{ fmt.Sprintf("%02d", *p.PCNumber) }</strong> |
						}
						{ p.School }
					</p>
				</div>
				<form method="POST" action="/logout">
					<button type="submit" class="bg-error text-on-error px-5 py-2 rounded-xl font-semibold hover:shadow-lg transition-shadow">
						Logout
					</button>
				</form>
			</div>
			<!-- Active module + countdown -->
			<div class="bg-surface-container-low p-5 rounded-xl flex items-center justify-between mb-8">
				<div>
					<p class="text-sm text-on-surface-variant">Active module</p>
					<p class="text-title-large font-manrope text-on-surface">
						if module != nil {
							{ module.Name }
						} else {
							-
						}
					</p>
				</div>
				<div class="text-right">
					<p class="text-sm text-on-surface-variant">Time remaining</p>
					<p id="countdown" class="text-title-large font-manrope text-on-surface">--:--:--</p>
				</div>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
				<!-- Left: download files -->
				<div class="lg:col-span-7 space-y-4">
					<div class="mb-6">
						<h2 class="text-2xl font-bold font-manrope text-on-surface">Download Files</h2>
						<p class="text-sm text-on-surface-variant">Official files</p>
					</div>
					<div id="official-files-list" class="space-y-4">
						if len(publicFiles) == 0 {
							<p class="empty-placeholder text-sm text-on-surface-variant">No public files yet.</p>
						}
						for _, f := range publicFiles {
							<div data-file-id={ f.ID } class="bg-surface-container-low p-5 rounded-xl flex justify-between items-center">
								<div class="flex items-center gap-4">
									<div class="w-12 h-12 bg-surface-container-high rounded-lg flex items-center justify-center">
										<span class="material-symbols-outlined">description</span>
									</div>
									<div>
										<p class="file-name font-bold text-on-surface">{ f.Name }</p>
									</div>
								</div>
								<a href={ templ.URL(fmt.Sprintf("/files/%s/download", f.ID)) } class="p-2 hover:bg-primary/10 text-primary rounded-lg">
									<span class="material-symbols-outlined">download</span>
								</a>
							</div>
						}
					</div>
				</div>
				<!-- Right: upload + guide -->
				<div class="lg:col-span-5">
					<div class="sticky top-24">
						<!-- Upload card -->
						<div class="rounded-2xl p-8 relative border-2 border-dashed border-outline-variant/30">
							<!-- Sensor overlay: hidden while the form is open -->
							<div id="sensor-layer"
								class={ "absolute inset-0 bg-surface-container-lowest/70 backdrop-blur-sm z-10 flex flex-col items-center justify-center text-center p-6 rounded-2xl", templ.KV("hidden", formOpen) }>
								<div class="w-16 h-16 bg-surface-container rounded-full flex items-center justify-center mb-4 shadow">
									<span class="material-symbols-outlined text-3xl text-on-surface-variant">lock</span>
								</div>
								<h3 class="font-bold text-lg mb-2 text-on-surface">Submission Locked</h3>
								<p class="text-sm text-on-surface-variant">Submission opens at last 20 minutes</p>
							</div>
							<div class="text-center mb-6">
								<span class="material-symbols-outlined text-4xl text-primary">cloud_upload</span>
								<h3 class="text-xl font-bold mt-2 text-on-surface">Upload Submission</h3>
							</div>
							<div id="existing-submission" class="mb-4">
								if existing != nil {
									<div class="bg-secondary-container text-on-secondary-container rounded-2xl p-4">
										<p class="text-body-medium">Submitted: <strong>{ existing.Name }</strong></p>
										if existing.SubmittedAt != nil {
											<p class="text-label-small">{ existing.SubmittedAt.Local().Format("15:04:05") }</p>
										}
										<p class="text-label-small mt-1">A new upload will replace this file.</p>
									</div>
								}
							</div>
							<span class="text-sm font-semibold text-on-surface mb-2 block">
								Upload Submission (Current module: <span id="module_name">
									if module != nil {
										{ module.Name }
									} else {
										-
									}
								</span>)
							</span>
							<input type="text" id="module_id" name="module_id" value={ moduleIDValue(module) } hidden/>
							<label id="dropzone"
								data-upload-type="submission"
								data-module-id={ moduleIDValue(module) }
								data-success-url="/"
								data-error-url="/?error="
								class="flex flex-col items-center justify-center gap-2 border-2 border-dashed border-outline rounded-2xl px-6 py-10 text-center cursor-pointer hover:bg-surface-container-highest transition-colors">
								<span class="text-body-large text-on-surface">Drag a file here or click to select</span>
								<input id="file-input" type="file" class="hidden"/>
							</label>
							<div id="progress-wrap" class="hidden mt-4">
								<div class="flex justify-between text-label-small text-on-surface-variant mb-1">
									<span id="progress-name"></span>
									<span id="progress-pct">0%</span>
								</div>
								<div class="w-full h-2 bg-surface-container-highest rounded-full overflow-hidden">
									<div id="progress-bar" class="h-full bg-primary transition-all" style="width:0%"></div>
								</div>
							</div>
						</div>
						<!-- Submission Guide -->
						<div class="mt-6 bg-surface-container-lowest p-6 rounded-xl ambient-shadow">
							<h4 class="font-bold text-on-surface mb-3">Submission Guide</h4>
							<ul class="text-sm space-y-2 text-on-surface-variant">
								<li>• Make sure the file name matches the requested format</li>
								<li>• Max file size: 70MB</li>
								<li>• Late submission will be rejected</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		<script src="/static/js/uploader.js"></script>
		<script src="/static/js/dashboard.js"></script>
	}
}

// moduleIDValue renders the hidden input value for the active module, "" when none.
func moduleIDValue(m *model.Module) string {
	if m == nil {
		return ""
	}
	return fmt.Sprintf("%d", m.ID)
}
