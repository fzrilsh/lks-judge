package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

func isCurrentModule(c *model.Competition, m *model.Module) bool {
	return c.CurrentModuleID != nil && *c.CurrentModuleID == m.ID
}

templ ModulesPage(comp *model.Competition, modules []*model.Module, saved bool, errMsg string) {
	@AppLayout("Modul", "modules") {
		<div class="max-w-6xl mx-auto px-12">
			if saved {
				<div class="bg-secondary-container text-on-secondary-container rounded-xl p-4 mb-8">
					<p class="text-body-medium">Saved successfully.</p>
				</div>
			}
			if errMsg != "" {
				<div class="bg-error-container text-on-error-container rounded-xl p-4 mb-8">
					<p class="text-body-medium">{ errMsg }</p>
				</div>
			}
			<div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-8">
				<div class="max-w-2xl">
					<h1 class="text-4xl font-manrope font-extrabold text-on-surface">
						Define Competition Modules
					</h1>
					<p class="mt-4 text-on-surface-variant">Atur module lomba untuk penilaian.</p>
				</div>
				if len(modules) > 0 {
					<form method="POST" action="/jury/modules/set-current"
						class="bg-surface-container-low p-6 rounded-xl ambient-shadow flex items-center gap-4">
						<div>
							<label class="text-xs font-bold text-primary block mb-1">Current Modules</label>
							<select name="module_id">
								for _, m := range modules {
									<option value={ fmt.Sprint(m.ID) } selected?={ isCurrentModule(comp, m) }>{ m.Name }</option>
								}
							</select>
						</div>
						<button class="signature-gradient text-white px-6 py-3 rounded font-bold text-sm">Save</button>
					</form>
				}
			</div>
			<!-- Bulk generate (real Go feature, no old-blade equivalent) -->
			<div class="bg-surface-container-low p-6 rounded-xl ambient-shadow mb-8">
				<h2 class="text-title-large text-on-surface font-manrope mb-2">Generate Modules</h2>
				<p class="text-body-small text-on-surface-variant mb-4">Creates MA, MB, MC, ... appended after existing modules.</p>
				<form method="POST" action="/jury/modules/generate" class="flex gap-3 items-end">
					<div>
						<label class="text-xs font-bold text-primary block mb-1">Total</label>
						<select name="total" class="bg-surface-container-high rounded px-4 py-2">
							for _, n := range []int{1, 2, 3, 4, 5, 6, 7} {
								<option value={ fmt.Sprint(n) }>{ fmt.Sprint(n) }</option>
							}
						</select>
					</div>
					<button type="submit" class="signature-gradient text-white px-6 py-3 rounded font-bold text-sm">Generate</button>
				</form>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				for i, m := range modules {
					<div class="bg-surface-container-lowest p-8 rounded-xl ambient-shadow relative">
						<div class="absolute left-0 top-0 w-2 h-full bg-primary"></div>
						<div class="flex justify-between items-start mb-4">
							<div class="h-12 w-12 bg-primary-container text-white rounded flex items-center justify-center font-bold">
								{ "M" + fmt.Sprint(i+1) }
							</div>
							<form method="POST" action={ templ.URL(fmt.Sprintf("/jury/modules/%d/delete", m.ID)) }>
								<button type="submit" class="text-red-500 hover:text-red-700" onclick="return confirm('Hapus modul ini?')">✕</button>
							</form>
						</div>
						<form method="POST" action={ templ.URL(fmt.Sprintf("/jury/modules/%d/rename", m.ID)) } class="space-y-4">
							<div>
								<label class="text-xs text-on-surface-variant block mb-1">Module Name</label>
								<input type="text" name="name" value={ m.Name } class="w-full bg-surface-container-high rounded px-4 py-2"/>
							</div>
							<button type="submit" class="w-full bg-primary text-white py-2 rounded-lg font-bold">Update</button>
						</form>
						if isCurrentModule(comp, m) {
							<span class="inline-block mt-4 text-xs font-bold px-3 py-1 rounded-lg bg-primary text-on-primary">Current</span>
						}
					</div>
				}
				<form method="POST" action="/jury/modules"
					class="border-2 border-dashed border-outline-variant rounded-xl flex flex-col items-center justify-center p-8 text-center hover:bg-surface-container-low">
					<input type="text" name="name" placeholder="New Module" required
						class="mb-3 bg-surface-container-high px-3 py-2 rounded text-center w-full"/>
					<button type="submit" class="text-sm font-bold text-primary">+ Tambah Module</button>
				</form>
			</div>
		</div>
	}
}
