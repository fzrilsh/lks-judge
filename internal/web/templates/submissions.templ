package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

// countSubmitted returns how many participants have at least one submission.
func countSubmitted(participants []*model.Participant, cell map[int64]map[int64]*model.Submission) int {
	n := 0
	for _, p := range participants {
		if len(cell[p.ID]) > 0 {
			n++
		}
	}
	return n
}

// moduleCount returns how many participants submitted for the given module.
func moduleCount(participants []*model.Participant, cell map[int64]map[int64]*model.Submission, moduleID int64) int {
	n := 0
	for _, p := range participants {
		if cell[p.ID][moduleID] != nil {
			n++
		}
	}
	return n
}

// Submissions renders the jury matrix: rows are participants, columns are modules.
// cell[participantID][moduleID] holds the submission for that pair, or nil.
templ Submissions(comp *model.Competition, participants []*model.Participant, modules []*model.Module, cell map[int64]map[int64]*model.Submission) {
	@AppLayout("Submissions", "submissions") {
		@PageHeader("Submission", "Pantau status pengumpulan tiap modul.") {
			<a href="/jury/submissions/export.zip" class="btn-tonal">
				<span class="material-symbols-outlined text-lg" aria-hidden="true">archive</span>
				Unduh Semua (.zip)
			</a>
		}
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
			@statCard("groups", "ok", "Total Peserta", len(participants))
			@statCard("task_alt", "ok", "Sudah Submit", countSubmitted(participants, cell))
			@statCard("view_module", "warn", "Total Modul", len(modules))
		</div>
		@Card("") {
			if len(participants) == 0 {
				@EmptyState("inbox", "Belum ada data", "Submission peserta muncul di sini.") {
				}
			} else {
				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Seat</th>
								<th>Peserta</th>
								for _, m := range modules {
									<th>
										<div class="whitespace-nowrap">{ m.Name }</div>
										<div class="text-label-small text-on-surface-variant normal-case">{ fmt.Sprintf("%d terkumpul", moduleCount(participants, cell, m.ID)) }</div>
									</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, p := range participants {
								<tr>
									<td class="font-bold">
										if p.PCNumber != nil {
											{ fmt.Sprintf("%02d", *p.PCNumber) }
										} else {
											-
										}
									</td>
									<td>
										<div class="text-on-surface">{ p.Name }</div>
										<div class="text-label-small text-on-surface-variant">{ p.School }</div>
									</td>
									for _, m := range modules {
										<td>
											if sub := cell[p.ID][m.ID]; sub != nil {
												<a href={ templ.URL(fmt.Sprintf("/jury/submissions/%s/download", sub.ID)) } class="chip chip-ok" aria-label={ "Unduh " + p.Name + " " + m.Name }>
													<span class="material-symbols-outlined text-sm" aria-hidden="true">download</span>
													Unduh
												</a>
											} else {
												<span class="chip chip-neutral">
													<span class="material-symbols-outlined text-sm" aria-hidden="true">pending</span>
													Pending
												</span>
											}
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

// statCard is a small metric tile used at the top of the submissions view.
templ statCard(icon string, kind string, label string, value int) {
	<section class="card flex items-center gap-4">
		<span class={ "w-12 h-12 rounded-full flex items-center justify-center flex-none", statTint(kind) }>
			<span class="material-symbols-outlined text-2xl" aria-hidden="true">{ icon }</span>
		</span>
		<div>
			<p class="text-label-small text-on-surface-variant uppercase tracking-wider">{ label }</p>
			<p class="text-headline-small font-bold text-on-surface">{ fmt.Sprintf("%d", value) }</p>
		</div>
	</section>
}

func statTint(kind string) string {
	switch kind {
	case "ok":
		return "bg-secondary-container text-on-secondary-container"
	case "warn":
		return "bg-warning-container text-on-warning-container"
	default:
		return "bg-primary-container text-on-primary-container"
	}
}
