package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/model"
)

// countSubmitted returns how many participants have at least one submission.
func countSubmitted(participants []*model.Participant, cell map[int64]map[int64]*model.Submission) int {
	n := 0
	for _, p := range participants {
		if len(cell[p.ID]) > 0 {
			n++
		}
	}
	return n
}

// moduleCount returns how many participants submitted for the given module.
func moduleCount(participants []*model.Participant, cell map[int64]map[int64]*model.Submission, moduleID int64) int {
	n := 0
	for _, p := range participants {
		if cell[p.ID][moduleID] != nil {
			n++
		}
	}
	return n
}

// Submissions renders the jury matrix: rows are participants, columns are modules.
// cell[participantID][moduleID] holds the submission for that pair, or nil.
templ Submissions(comp *model.Competition, participants []*model.Participant, modules []*model.Module, cell map[int64]map[int64]*model.Submission) {
	@AppLayout("Submissions", "submissions") {
		<div class="max-w-7xl mx-auto px-8 md:px-12">
			<div class="mb-10 flex items-start justify-between gap-6">
				<div>
					<h1 class="text-4xl font-manrope font-extrabold text-on-surface">Participant Submissions</h1>
					<p class="mt-4 text-on-surface-variant">Pantau status pengumpulan hasil kerja peserta untuk setiap modul kompetisi.</p>
				</div>
				<a href="/jury/submissions/export.zip"
					class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold rounded-lg bg-green-500/10 text-green-700 hover:bg-green-500/20 hover:scale-105 active:scale-95 transition-all whitespace-nowrap">
					<span class="material-symbols-outlined text-[16px]">archive</span>
					Unduh Semua (.zip)
				</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
				<div class="bg-surface-container-lowest p-6 rounded-xl ambient-shadow border border-outline-variant/20 flex items-center gap-5">
					<div class="w-14 h-14 rounded-full bg-primary/10 text-primary flex items-center justify-center">
						<span class="material-symbols-outlined text-3xl">groups</span>
					</div>
					<div>
						<p class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1">Total Peserta</p>
						<h2 class="text-3xl font-manrope font-bold text-on-surface">{ fmt.Sprintf("%d", len(participants)) }</h2>
					</div>
				</div>
				<div class="bg-surface-container-lowest p-6 rounded-xl ambient-shadow border border-outline-variant/20 flex items-center gap-5">
					<div class="w-14 h-14 rounded-full bg-green-500/10 text-green-600 flex items-center justify-center">
						<span class="material-symbols-outlined text-3xl">task_alt</span>
					</div>
					<div>
						<p class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1">Peserta Submit</p>
						<h2 class="text-3xl font-manrope font-bold text-on-surface">{ fmt.Sprintf("%d", countSubmitted(participants, cell)) }</h2>
					</div>
				</div>
				<div class="bg-surface-container-lowest p-6 rounded-xl ambient-shadow border border-outline-variant/20 flex items-center gap-5">
					<div class="w-14 h-14 rounded-full bg-orange-500/10 text-orange-600 flex items-center justify-center">
						<span class="material-symbols-outlined text-3xl">view_module</span>
					</div>
					<div>
						<p class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1">Total Module</p>
						<h2 class="text-3xl font-manrope font-bold text-on-surface">{ fmt.Sprintf("%d", len(modules)) }</h2>
					</div>
				</div>
			</div>
			<div class="bg-surface-container-lowest rounded-xl ambient-shadow border border-outline-variant/20 overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full text-sm text-left border-collapse">
						<thead class="bg-surface-container-low border-b border-outline-variant/30">
							<tr>
								<th class="px-6 py-5 font-bold text-on-surface uppercase tracking-wider text-xs">Seat</th>
								<th class="px-6 py-5 font-bold text-on-surface uppercase tracking-wider text-xs">Participant</th>
								for _, m := range modules {
									<th class="px-6 py-5 text-center border-l border-outline-variant/20 min-w-[140px]">
										<div class="font-bold text-on-surface whitespace-nowrap">{ m.Name }</div>
										<div class="text-[10px] text-on-surface-variant uppercase tracking-widest mt-1.5">{ fmt.Sprintf("%d", moduleCount(participants, cell, m.ID)) } Terkumpul</div>
									</th>
								}
							</tr>
						</thead>
						<tbody class="divide-y divide-outline-variant/20">
							if len(participants) == 0 {
								<tr>
									<td colspan={ fmt.Sprintf("%d", len(modules)+2) } class="px-6 py-12 text-center text-on-surface-variant">Belum ada data peserta yang tersedia.</td>
								</tr>
							}
							for _, p := range participants {
								<tr class="hover:bg-surface-container-low/50 transition-colors">
									<td class="px-6 py-4">
										<div class="w-10 h-10 rounded-lg bg-surface-container-high border border-outline-variant/30 flex items-center justify-center font-bold text-on-surface">
											if p.PCNumber != nil {
												{ fmt.Sprintf("%02d", *p.PCNumber) }
											} else {
												-
											}
										</div>
									</td>
									<td class="px-6 py-4">
										<div class="font-bold text-on-surface text-base">{ p.Name }</div>
										<div class="text-xs text-on-surface-variant mt-1">{ p.School }</div>
									</td>
									for _, m := range modules {
										<td class="px-6 py-4 text-center border-l border-outline-variant/20">
											if sub := cell[p.ID][m.ID]; sub != nil {
												<a href={ templ.URL(fmt.Sprintf("/jury/submissions/%s/download", sub.ID)) }
													class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold rounded-lg bg-green-500/10 text-green-700 hover:bg-green-500/20 hover:scale-105 active:scale-95 transition-all">
													<span class="material-symbols-outlined text-[16px]">download</span>
													Unduh
												</a>
											} else {
												<span class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold rounded-lg bg-surface-container-highest text-on-surface-variant opacity-70">
													<span class="material-symbols-outlined text-[16px]">pending</span>
													Belum
												</span>
											}
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}
