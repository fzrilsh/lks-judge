package templates

import "github.com/fzrilsh/lks-judge/internal/model"

func derefStr(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}

templ CompetitionPage(c *model.Competition, saved bool) {
	@AppLayout("Competition", "competition") {
		<div class="max-w-2xl mx-auto">
			<div class="bg-surface-container-low rounded-3xl shadow-lg p-8">
				<h1 class="text-headline-large text-on-surface font-manrope mb-6">Competition Setup</h1>
				if saved {
					<div class="bg-tertiary-container text-on-tertiary-container rounded-xl p-4 mb-6">
						<p class="text-body-medium">Saved successfully.</p>
					</div>
				}
				<form method="POST" action="/jury/" class="space-y-5">
					<div>
						<label for="name" class="block text-label-large text-on-surface mb-2">Name</label>
						<input type="text" id="name" name="name" required value={ c.Name }
							class="w-full px-4 py-3 bg-surface-container-highest text-on-surface rounded-xl border border-outline focus:outline-none focus:ring-2 focus:ring-primary"/>
					</div>
					<div>
						<label for="level" class="block text-label-large text-on-surface mb-2">Level</label>
						<input type="text" id="level" name="level" required value={ c.Level }
							class="w-full px-4 py-3 bg-surface-container-highest text-on-surface rounded-xl border border-outline focus:outline-none focus:ring-2 focus:ring-primary"/>
					</div>
					<div>
						<label for="allowed_ips" class="block text-label-large text-on-surface mb-2">Allowed IPs (JSON array)</label>
						<input type="text" id="allowed_ips" name="allowed_ips" value={ c.AllowedIPs }
							placeholder={ `["192.168.1.1","192.168.1.2"]` }
							class="w-full px-4 py-3 bg-surface-container-highest text-on-surface rounded-xl border border-outline focus:outline-none focus:ring-2 focus:ring-primary"/>
					</div>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="start_date" class="block text-label-large text-on-surface mb-2">Start Date</label>
							<input type="date" id="start_date" name="start_date" required value={ c.StartDate }
								class="w-full px-4 py-3 bg-surface-container-highest text-on-surface rounded-xl border border-outline focus:outline-none focus:ring-2 focus:ring-primary"/>
						</div>
						<div>
							<label for="end_date" class="block text-label-large text-on-surface mb-2">End Date</label>
							<input type="date" id="end_date" name="end_date" required value={ c.EndDate }
								class="w-full px-4 py-3 bg-surface-container-highest text-on-surface rounded-xl border border-outline focus:outline-none focus:ring-2 focus:ring-primary"/>
						</div>
					</div>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="start_time" class="block text-label-large text-on-surface mb-2">Start Time</label>
							<input type="time" id="start_time" name="start_time" value={ derefStr(c.StartTime) }
								class="w-full px-4 py-3 bg-surface-container-highest text-on-surface rounded-xl border border-outline focus:outline-none focus:ring-2 focus:ring-primary"/>
						</div>
						<div>
							<label for="end_time" class="block text-label-large text-on-surface mb-2">End Time</label>
							<input type="time" id="end_time" name="end_time" value={ derefStr(c.EndTime) }
								class="w-full px-4 py-3 bg-surface-container-highest text-on-surface rounded-xl border border-outline focus:outline-none focus:ring-2 focus:ring-primary"/>
						</div>
					</div>
					<div>
						<span class="block text-label-large text-on-surface mb-2">Status</span>
						<p class="px-4 py-3 bg-surface-container text-on-surface-variant rounded-xl border border-outline">
							{ c.Status } <span class="text-body-small">— controlled from the Countdown page</span>
						</p>
					</div>
					<button type="submit"
						class="w-full bg-primary text-on-primary font-semibold py-3 rounded-xl hover:shadow-lg transition-shadow">
						Save Competition
					</button>
				</form>
			</div>
		</div>
	}
}
