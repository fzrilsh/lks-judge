package templates

import (
	"fmt"
	"github.com/fzrilsh/lks-judge/internal/store"
)

templ ShufflePage(results []store.ShuffleResult) {
	@AppLayout("Shuffle", "participants") {
		@PageHeader("PC Number Assignment", "Shuffle participants into PC numbers.") {
			<a href="/jury/participants" class="btn-ghost">
				<span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_back</span>
				Back
			</a>
			<form method="POST" action="/jury/participants/shuffle">
				<button type="submit" class="btn-primary">
					<span class="material-symbols-outlined text-lg" aria-hidden="true">shuffle</span>
					if len(results) == 0 {
						Start Shuffle
					} else {
						Re-shuffle
					}
				</button>
			</form>
		}
		if len(results) == 0 {
			@Card("") {
				@EmptyState("shuffle", "Nothing shuffled yet", "Add participants then run the shuffle.") {
				}
			}
		} else {
			@Flash("success", fmt.Sprintf("Shuffle done. %d participants placed.", len(results)))
			@Card("PC Seat Map") {
				<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
					for _, r := range results {
						<div class="bg-surface-container rounded-xl p-4 flex flex-col items-center justify-center text-center min-h-[100px]">
							<span class="text-label-small text-outline font-bold mb-1">PC - { fmt.Sprintf("%02d", r.Seat) }</span>
							<span class="text-body-medium font-bold text-on-surface">{ r.Name }</span>
							<span class="text-label-small text-on-surface-variant mt-1">{ r.School }</span>
						</div>
					}
				</div>
			}
		}
	}
}
