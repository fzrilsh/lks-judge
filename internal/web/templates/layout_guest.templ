package templates

templ GuestLayout(title string) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - LKS Judge Platform</title>
		<link rel="icon" type="image/png" href="/static/imgs/logo.png"/>
		<link rel="stylesheet" href="/static/css/app.css"/>
	</head>
	<body class="bg-surface text-on-surface min-h-screen font-manrope">
		<main class="min-h-screen">
			{ children... }
		</main>
	</body>
	</html>
}

// TVLayout is a chromeless full-screen shell for projector pages (the public
// countdown): no navbar, content vertically centered.
templ TVLayout(title string) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - LKS Judge Platform</title>
		<link rel="icon" type="image/png" href="/static/imgs/logo.png"/>
		<link rel="stylesheet" href="/static/css/app.css"/>
	</head>
	<body class="bg-surface text-on-surface min-h-screen flex items-center justify-center font-manrope">
		{ children... }
	</body>
	</html>
}
